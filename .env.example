# ========================================================
# Personal Indian IPO Allotment Tracker - Environment Config
# ========================================================

PORT=5000
HOST_BIND=127.0.0.1
NODE_ENV=production

# PostgreSQL Database Settings
POSTGRES_DB=ipo_db
POSTGRES_USER=ipo_user
POSTGRES_PASSWORD=generate_a_secure_password_for_postgres_here

# Security Secrets (Generate using: openssl rand -base64 32)
# Mandatory 32+ character key for AES-256-GCM PAN encryption
PAN_ENCRYPTION_KEY=generate_a_secure_32_char_pan_encryption_key_here
# Mandatory 32+ character key for PAN HMAC-SHA256 fingerprinting
PAN_HMAC_KEY=generate_a_secure_32_char_pan_hmac_key_here
# Mandatory 32+ character JWT authentication signing secret
JWT_SECRET=generate_a_secure_32_char_jwt_secret_here

# Internal PEEK microservice URL
PEEK_SERVICE_URL=http://ipo_peek:8000

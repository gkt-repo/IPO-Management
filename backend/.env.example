# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://ipo_user:ipo_secure_password_2026@localhost:5434/ipo_db?schema=public

# Application Layer Encryption Keys (32+ characters)
# AES-256-GCM Key for encrypting PAN values
PAN_ENCRYPTION_KEY=replace_with_a_secure_32_char_encryption_key_here
# HMAC Key for PAN indexing fingerprint
PAN_HMAC_KEY=replace_with_a_secure_32_char_hmac_key_for_indexing_here

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long

# PEEK Microservice URL
PEEK_SERVICE_URL=http://localhost:8000
